# Supabase project URL — Dashboard → Project Settings → API (https://<ref>.supabase.co)
SUPABASE_URL=
# Publishable key (sb_publishable_...) — safe to expose, but we only use it server-side
SUPABASE_PUBLIC_KEY=
# Secret key (sb_secret_...) — SERVER ONLY. Never import it into client code.
SUPABASE_SECRET_KEY=
# Anthropic API anahtarı — SERVER ONLY. Opsüyon AI yardım asistanı için (console.anthropic.com)
CLAUDE_API_KEY=
# Sitenin yayındaki adresi (ör. https://www.opsuyon.com). Kanonik adresler, site haritası, paylaşım görselleri ve devriye QR etiketleri bunu kullanır.
# Boşsa site için https://opsuyon-nt.vercel.app, QR etiketleri için isteğin adresi kullanılır.
SITE_URL=
# Arama motorlarına açma anahtarı: yalnızca "true" iken robots.txt açılır ve sayfalardan noindex kalkar. Şirket bilgileri
# (src/lib/site.ts) doldurulmadan AÇMAYIN. Derleme anında okunur: değiştirince yeniden yayınlayın.
SITE_INDEXABLE=
# İsteğe bağlı — SERVER ONLY. İletişim formu damgası ve IP özeti için gizli anahtar; boşsa SUPABASE_SECRET_KEY'den türetilir.
CONTACT_FORM_SECRET=
